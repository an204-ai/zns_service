# ========================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN ZNS RESELLER PLATFORM
# Hướng dẫn: Tạo bản sao file này thành .env trên VPS/Máy chủ
# Lệnh: cp .env.example .env
# ========================================================

# ===== MÔI TRƯỜNG & PORT =====
NODE_ENV=production
PORT=4000
FRONTEND_PORT=3000

# Domain hoặc URL truy cập frontend (cho phép nhiều domain, phân cách bằng dấu phẩy)
# Ví dụ: FRONTEND_URL=https://thanhan.site,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# (Tùy chọn) Chỉ cần khi Frontend và Backend nằm trên 2 domain/host riêng biệt
# Mặc định Frontend sẽ dùng Relative Path /api/v1 (cùng domain qua Nginx)
# VITE_API_URL=https://api.yourdomain.com/api/v1
# VITE_WS_URL=https://api.yourdomain.com

# ===== DATABASE (POSTGRESQL) =====
POSTGRES_DB=zns_reseller
POSTGRES_USER=zns_user
POSTGRES_PASSWORD=zns_password_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zns_user:zns_password_change_me@postgres:5432/zns_reseller?schema=public

# ===== REDIS CACHE =====
REDIS_HOST=cache_redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me

# ===== RABBITMQ MESSAGE BROKER =====
RABBITMQ_DEFAULT_USER=zns_user
RABBITMQ_DEFAULT_PASS=rabbitmq_password_change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://zns_user:rabbitmq_password_change_me@broker_rabbitmq:5672

# ===== JWT SECURITY =====
JWT_ACCESS_SECRET=zns_secret_access_key_jwt_super_secure_2026_change_in_prod
JWT_REFRESH_SECRET=zns_secret_refresh_key_jwt_super_secure_2026_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== AES ENCRYPTION KEY (Đúng 32 ký tự) =====
ENCRYPTION_KEY=zns_reseller_aes256_secret_key_32

# ===== FPT ZBS BASE API =====
FPT_ZBS_BASE_URL=https://api-zbs.fpt.work

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_MAX=30
