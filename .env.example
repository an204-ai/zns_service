# ===== DATABASE =====
DATABASE_URL=postgresql://zns_user:zns_password@localhost:5432/zns_reseller?schema=public

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ===== RABBITMQ =====
RABBITMQ_URL=amqp://zns_user:zns_password@localhost:5672

# ===== JWT =====
JWT_ACCESS_SECRET=your-access-secret-key-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== FPT ZBS =====
FPT_ZBS_BASE_URL=https://api-zbs.fpt.work

# ===== ENCRYPTION =====
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ===== SERVER =====
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_MAX=30
