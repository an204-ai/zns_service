// Prisma Schema for ZNS Reseller Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OAStatus {
  ACTIVE
  INACTIVE
}

enum TemplateStatus {
  ENABLE
  PENDING
  LOCKED
}

enum MessageStatus {
  QUEUED
  SENT
  SUCCESS
  FAILED
}

enum CampaignStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum CampaignSource {
  EXCEL
  API
  PORTAL
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(255)
  companyName   String?   @map("company_name") @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  role          UserRole  @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  apiKeys             ApiKey[]
  oaConfigs           FptOaConfig[]
  systemOaAssignments CustomerOaAssignment[]
  messages            Message[]
  campaigns           Campaign[]

  @@map("users")
}

model FptOaConfig {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  oaName                String    @map("oa_name") @db.VarChar(255)
  oaId                  String?   @map("oa_id") @db.VarChar(100)
  fptAppId              String    @map("fpt_app_id") @db.VarChar(255)
  fptSecretKeyEncrypted String    @map("fpt_secret_key_encrypted") @db.Text
  status                OAStatus  @default(ACTIVE)
  isSystem              Boolean   @default(false) @map("is_system")
  oaInfo                Json?     @map("oa_info") @db.JsonB
  syncedAt              DateTime? @map("synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user        User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates   ZnsTemplate[]
  messages    Message[]
  campaigns   Campaign[]
  assignments CustomerOaAssignment[]
  apiKeys     ApiKey[]

  @@map("fpt_oa_configs")
}

model CustomerOaAssignment {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  oaConfigId String      @map("oa_config_id") @db.Uuid
  assignedAt DateTime    @default(now()) @map("assigned_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  oaConfig FptOaConfig @relation(fields: [oaConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, oaConfigId])
  @@map("customer_oa_assignments")
}

model ZnsTemplate {
  id               String          @id @default(uuid()) @db.Uuid
  fptOaConfigId    String          @map("fpt_oa_config_id") @db.Uuid
  templateId       Int             @map("template_id")
  templateName     String          @map("template_name") @db.VarChar(500)
  templateTag      String?         @map("template_tag") @db.VarChar(100)
  templateQuality  String?         @map("template_quality") @db.VarChar(50)
  listParams       Json?           @map("list_params") @db.JsonB
  listButtons      Json?           @map("list_buttons") @db.JsonB
  previewUrl       String?         @map("preview_url") @db.Text
  templateContent  String?         @map("template_content") @db.Text
  status           TemplateStatus  @default(ENABLE)
  syncedAt         DateTime?       @map("synced_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  fptOaConfig      FptOaConfig     @relation(fields: [fptOaConfigId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@unique([fptOaConfigId, templateId])
  @@map("zns_templates")
}

model ApiKey {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  oaConfigId      String?      @map("oa_config_id") @db.Uuid
  keyName         String       @map("key_name") @db.VarChar(255)
  apiKeyHash      String       @map("api_key_hash") @db.VarChar(255)
  apiKeyEncrypted String?      @map("api_key_encrypted") @db.Text
  prefix          String       @db.VarChar(10)
  isActive        Boolean      @default(true) @map("is_active")
  lastUsedAt      DateTime?    @map("last_used_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  oaConfig    FptOaConfig? @relation(fields: [oaConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, oaConfigId])
  @@map("api_keys")
}

model Campaign {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  name            String          @db.VarChar(500)
  fptOaConfigId   String          @map("fpt_oa_config_id") @db.Uuid
  templateId      Int             @map("template_id")
  totalMessages   Int             @default(0) @map("total_messages")
  sentCount       Int             @default(0) @map("sent_count")
  successCount    Int             @default(0) @map("success_count")
  failedCount     Int             @default(0) @map("failed_count")
  status          CampaignStatus  @default(PENDING)
  source          CampaignSource  @default(PORTAL)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fptOaConfig     FptOaConfig     @relation(fields: [fptOaConfigId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@map("campaigns")
}

model Message {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  campaignId      String?       @map("campaign_id") @db.Uuid
  fptOaConfigId   String        @map("fpt_oa_config_id") @db.Uuid
  templateId      Int           @map("template_id")
  phone           String        @db.VarChar(20)
  templateData    Json          @map("template_data") @db.JsonB
  fptMessageId    String?       @map("fpt_message_id") @db.VarChar(255)
  refId           String?       @map("ref_id") @db.VarChar(255)
  status          MessageStatus @default(QUEUED)
  errorCode       String?       @map("error_code") @db.VarChar(20)
  errorMessage    String?       @map("error_message") @db.Text
  callbackUrl     String?       @map("callback_url") @db.Text
  retryCount      Int           @default(0) @map("retry_count")
  sentAt          DateTime?     @map("sent_at")
  deliveredAt     DateTime?     @map("delivered_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  fptOaConfig     FptOaConfig   @relation(fields: [fptOaConfigId], references: [id], onDelete: Cascade)
  template        ZnsTemplate?  @relation(fields: [fptOaConfigId, templateId], references: [fptOaConfigId, templateId])

  @@index([userId, createdAt(sort: Desc)])
  @@index([fptMessageId])
  @@index([status])
  @@index([campaignId])
  @@map("messages")
}

model SystemLog {
  id          String    @id @default(uuid()) @db.Uuid
  action      String    @db.VarChar(255)
  actorId     String?   @map("actor_id") @db.Uuid
  actorRole   String?   @map("actor_role") @db.VarChar(20)
  entityType  String?   @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.VarChar(255)
  details     Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}
